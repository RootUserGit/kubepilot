.github/
infra/
deploy/
scripts/
services/
docs/

# Keep `data/` tracked: Alembic migrations live under `data/migrations/` (see alembic.ini).
# Keep `packages/` tracked: `tests/test_openapi.py` and the hand-written API contract.

# LLM / serving track is separate from the Python app for now
ai/

# Optional local hooks config (not required to run the app)
.pre-commit-config.yaml
