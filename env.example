# Copy to `.env` in the repo root (same folder as `docker-compose.yml`).
# Used by pydantic-settings and Alembic (env.py loads this file).

# development | staging | production — Swagger/ReDoc at /v1/docs only when NOT production
KUBEPILOT_ENVIRONMENT=development

# Postgres is published as host port 5433 → container 5432 (see docker-compose.yml).
KUBEPILOT_DATABASE_URL=postgresql+psycopg://kubepilot:kubepilot@127.0.0.1:5433/kubepilot
KUBEPILOT_REDIS_URL=redis://127.0.0.1:6379/0
KUBEPILOT_ALLOW_STORE_KUBECONFIG=true

# AWS onboarding (IAM Role + CloudFormation quick-create)
# KubePilot account ID embedded in the CloudFormation trust policy (override only if it changes).
KUBEPILOT_AWS_ONBOARDING_ACCOUNT_ID=787943461725
# Required to save IAM user profiles (openssl rand -hex 32)
# KUBEPILOT_CREDENTIALS_ENCRYPTION_KEY=
# Optional: specific IAM role ARN in the KubePilot account used to call sts:AssumeRole.
# KUBEPILOT_AWS_ONBOARDING_PRINCIPAL_ARN=arn:aws:iam::787943461725:role/kubepilot-onboarding
# Public HTTPS S3 URL to deploy/cloudformation/kubepilot-readonly-role.yaml (same region as the stack).
# KUBEPILOT_CLOUDFORMATION_TEMPLATE_URL=https://your-bucket.s3.us-east-1.amazonaws.com/kubepilot-readonly-role.yaml

# Optional: simulate in-cluster agent check-in after N seconds (local UX / demos only).
# Without this, registration stays in "awaiting_agent" until a real agent updates status.
# KUBEPILOT_SIMULATE_AGENT_CONNECT_SECONDS=12
KUBEPILOT_FEATURE_CLOUDWATCH=false
KUBEPILOT_FEATURE_COST_EXPLORER=false
# LLM: separate OpenAI-compatible server. Do NOT point at KubePilot (port 8000).
# Local Ollama: ollama pull llama3.2:3b && ollama serve
#   KUBEPILOT_LLM_ENABLED=true
#   KUBEPILOT_LLM_ENDPOINT=http://127.0.0.1:11434
#   KUBEPILOT_LLM_MODEL=llama3.2:3b
KUBEPILOT_LLM_ENABLED=false
KUBEPILOT_LLM_ENDPOINT=http://127.0.0.1:11434
KUBEPILOT_LLM_MODEL=llama3.2:3b

# Next.js frontend CORS (comma-separated origins)
KUBEPILOT_CORS_ORIGINS=http://localhost:3000

# Next.js public site links (set in frontend/.env.local or pass at build time)
# NEXT_PUBLIC_KUBEPILOT_IT_PORTAL_URL=https://it.yourcompany.com/request-access
# NEXT_PUBLIC_KUBEPILOT_SUPPORT_EMAIL=kubepilot-support@yourcompany.com

# OAuth / Google Sign-In (see README — Google Cloud Console setup)
KUBEPILOT_FRONTEND_URL=http://localhost:3000
KUBEPILOT_API_PUBLIC_URL=http://localhost:8000
# Required — API will not start without these (Google Sign-In)
# KUBEPILOT_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# KUBEPILOT_GOOGLE_CLIENT_SECRET=your-client-secret
# KUBEPILOT_AUTH_SESSION_SECRET=   # openssl rand -hex 32  (min 32 characters)

# Browser sessions use HttpOnly cookies on the API host (not localStorage).
# KUBEPILOT_AUTH_COOKIE_NAME=kubepilot_session
# KUBEPILOT_AUTH_COOKIE_MAX_AGE_SECONDS=86400   # 1 day absolute session cap
# KUBEPILOT_AUTH_COOKIE_SECURE=true
# KUBEPILOT_AUTH_COOKIE_SAMESITE=lax
# KUBEPILOT_AUTH_SESSION_SLIDING=true
KUBEPILOT_AUTH_SESSION_IDLE_SECONDS=14400   # 4 hours without activity → logout

# Google Cloud Console → OAuth 2.0 Client ID → Web application (EXACT strings, no trailing slash):
#   Authorized JavaScript origins:  http://localhost:3000
#   Authorized redirect URIs:       http://localhost:8000/v1/auth/sso/google/callback
#   (If you use 127.0.0.1 in the browser, also add:
#    http://127.0.0.1:8000/v1/auth/sso/google/callback)
# Verify at startup in API logs, or GET http://localhost:8000/v1/auth/sso/google/setup

# Helm chart index URL for generated agent install commands (parent of index.yaml).
# When set, the API embeds this in --repo so users can copy-paste without helm repo add.
# When unset, the generated command uses: --repo "${KUBEPILOT_HELM_AGENT_REPO_INDEX_URL:?...}"
# KUBEPILOT_HELM_AGENT_REPO_INDEX_URL=https://your-org.github.io/kubepilot-helm/

# Multi-tenant / agent (SaaS)
# KUBEPILOT_AGENT_SERVICE_TOKEN=   # optional; in-cluster agent sends X-KubePilot-Agent-Token
# KUBEPILOT_LOG_JSON=false
# KUBEPILOT_RATE_LIMIT_IP_RPM=0   # e.g. 120 to enable Redis per-IP rate limit

# Health (unauthenticated): GET /v1/healthcheck → 200 if Postgres + Redis OK

# API docs (non-production only): http://localhost:8000/v1/docs (Swagger), /v1/redoc, /v1/openapi.json

# Export machine-readable OpenAPI after API changes: `make openapi-export` → packages/openapi/openapi.generated.json